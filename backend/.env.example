PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- Cookie 管理服务集成（可选） ----
# 启用后，系统将优先从 bili-cookie-manager 服务获取有效 Cookie，
# 单个账号失效时自动切换至其他账号，失败时回退到本地 cookies.json。
#
# 直接部署（bili-cookie-manager 与本服务运行在同一台机器上）：
#   COOKIE_MANAGER_URL=http://localhost:3100
#
# Docker Compose 部署（见 docker-compose.yml 中的 bili-cookie-manager 服务）：
#   COOKIE_MANAGER_URL=http://bili-cookie-manager:3100
#
# 留空或注释掉则禁用，仅使用本地 cookies.json。
COOKIE_MANAGER_URL=
